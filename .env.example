SUPABASE_URL=https://loecyghnkkxyymelgexz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
PORT=8001
APP_ENV=local
JOOLA_BRAND_ID=04db8591-37a3-4634-9d11-536975fa6935

# Local only: the in-process scheduler. Forced off on Vercel (VERCEL=1), where
# Vercel Cron calls GET /api/cron/pipeline instead (see vercel.json).
POLL_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=true

# Required on Vercel: any long random string. Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>`; the cron route rejects anything else.
CRON_SECRET=

# Comma-separated origins allowed to call this API directly from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
